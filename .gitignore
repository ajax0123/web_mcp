# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
# FE-1: the frontend production bundle IS committed so `python3 serve.py 5173`
# works with no npm / Vite. Rebuild with `cd frontend && npm run build`.
!frontend/dist/
!frontend/dist/**

# --- Dependency lock: regenerated per build (scripts/lock.sh); the intentionally
#     committed one is requirements.committed.lock (CI diffs against it). ---
requirements.lock

# --- Virtualenvs (rebuild from cyberguard_api/requirements.txt; see scripts/bootstrap.sh) ---
.venv/
.venv-*/
venv/
env/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- OS / editor cruft ---
.DS_Store
*.swp
.env.example
# FE-1: frontend build deps are NOT committed (were an incomplete, platform-
# specific snapshot). `cd frontend && npm install` to get `npm run dev`; the
# committed frontend/dist/ bundle is what `serve.py` needs and needs no install.
frontend/node_modules/
