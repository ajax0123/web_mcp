# CyberGuard — environment template
# --------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed. Never put real secrets in .env.example.
#
#   cp .env.example .env
#
# Run from the repo root (web_mcp/):
#   uvicorn cyberguard_api.main:app --host 0.0.0.0 --port 8000 \
#     --proxy-headers --forwarded-allow-ips "$FORWARDED_ALLOW_IPS"
# ==========================================================================

# --- Deployment mode ------------------------------------------------------
# dev | staging | production.  production is FAIL-CLOSED: the process refuses
# to start unless API_KEYS and CORS_ORIGINS are set, disables /docs, and turns
# on HSTS.
APP_ENV=dev

# --- API authentication (C-3) -------------------------------------------
# Comma-separated list of accepted keys. Callers send either:
#   X-API-Key: <key>            or        Authorization: Bearer <key>
# Empty + APP_ENV=dev  -> auth bypassed (warns once).
# Empty + APP_ENV=production -> startup error.
API_KEYS=

# --- Rate limiting (C-3) ------------------------------------------------
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true
# "memory://" (per-process) or "redis://host:6379/1" for multi-worker deploys.
RATE_LIMIT_STORAGE_URI=memory://

# --- Request size / edge (M-11, H-4) ----------------------------------
# Max request body in bytes; over this -> 413 before the body is read.
MAX_BODY_BYTES=1000000
# HSTS max-age (seconds). 0 = omit header (dev). Auto-set to 31536000 in prod.
HSTS_MAX_AGE=0

# --- Reverse proxy / real client IP (H-6) ---------------------------
# uvicorn flag: which upstream socket peers may set X-Forwarded-For.
# Set to your load-balancer / ingress IP(s); never "*" in production.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional in-app defence-in-depth: CIDRs whose XFF header we additionally trust.
TRUSTED_PROXY_IPS=

# --- CORS (M-8 / L-5) --------------------------------------------------
# Allowed browser origins for /api/v1/*. JSON array OR comma-delimited list.
# Unset + APP_ENV=dev -> localhost dev origins. Unset + production -> error.
# CORS_ORIGINS=["https://soc.example.com","https://console.example.com"]
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Interactive docs --------------------------------------------------
# Swagger/ReDoc are served only when true AND APP_ENV != production.
ENABLE_DOCS=true

# --- ML scoring ------------------------------------------------------------
# Login Random Forest operating threshold. 0.70 default trades recall for
# precision (see cyberguard_api/models/cyberguard_rf_final_metadata.json).
LOGIN_THRESHOLD=0.70

# --- PII scope unlock --------------------------------------------------------
# REMOVED (audit M-5). The static `?scope=full` + X-Scope-Token bypass that
# returned unmasked usernames / IPs is gone. Every user projection is now
# always masked (cyberguard_api/services/telemetry.project_user). This var is
# no longer read by the application.
# CYBERGUARD_SCOPED_TOKEN=

# --- Identity / auth (security layer) --------------------------------------
# REQUIRED in any non-local environment. Min 32 chars, high entropy.
JWT_SECRET_KEY=
TOKEN_TTL_SECONDS=300
MFA_REQUIRED=true
ODAC_ENABLED=true

# --- Runtime protection toggles ------------------------------------------
RASP_ENABLED=true
WAF_ENABLED=true
API_SCHEMA_VALIDATION=true
CONTAINMENT_AUTO_TRIGGER=true
TELEMETRY_SAMPLE_RATE=1.0

# --- Rate limiting (legacy security-layer config) ----------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Infrastructure / SIEM --------------------------------------------------
SBOM_ENFORCEMENT=true
SECRET_ROTATION_DAYS=30
POLICY_AS_CODE_ENABLED=true
AUDIT_ENCRYPTION_ENABLED=true
SOAR_AUTO_RESPONSE=true
# ALERT_WEBHOOK_URL=https://hooks.example.com/soc-alerts

# --- External services (optional) ---------------------------------------
# REDIS_URL=redis://localhost:6379/0
# HIBP_API_KEY=
# VAULT_URL=http://localhost:8200
# VAULT_TOKEN=

# --- Telemetry data source (PP-C2) ------------------------------------
# mock -> two-record demo store (dev/tests only; refused when APP_ENV=production)
# external -> HTTP adapter, requires TELEMETRY_API_URL
TELEMETRY_BACKEND=mock
# TELEMETRY_API_URL=https://telemetry.internal/api
# TELEMETRY_API_TOKEN=
# TELEMETRY_API_TIMEOUT=3.0

# --- ML inference pool & batch bounds (PP-H5) ------------------------
INFERENCE_POOL_SIZE=4
INFERENCE_TIMEOUT_SECONDS=5.0
ML_MAX_BATCH=200

# --- Observability (PP-H4) ------------------------------------------
LOG_LEVEL=INFO
# /metrics is always mounted (rate-limit-exempt); scrape it with Prometheus.

# --- Model artifact integrity (PP-M1 / PP-C5) ----------------------
# In production CYBERGUARD_MODEL_MANIFEST must resolve OUTSIDE cyberguard_api/models/.
# CYBERGUARD_MODEL_MANIFEST=/etc/cyberguard/model-manifest.json
# CYBERGUARD_MODEL_MANIFEST_SIG=/etc/cyberguard/model-manifest.json.sig     # Ed25519 detached
# CYBERGUARD_MODEL_MANIFEST_PUBKEY=/etc/cyberguard/model-manifest.pub
# CYBERGUARD_VERIFY_MODELS_ON_IMPORT=1

# --- Frontend (frontend/serve.py + frontend/config.js) -------------
# CSP connect-src for the dashboard's dev server; must include the API origin.
CYBERGUARD_CONNECT_SRC=http://localhost:8000
